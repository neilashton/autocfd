{% assign load_publication_badges = false %}
{% if page.publication_badges or page.related_publications or page.layout == 'bib' or page.permalink == '/publications/' %}
  {% assign load_publication_badges = true %}
{% endif %}

{% if load_publication_badges %}
  {% if site.enable_publication_badges.altmetric %}
    <script async src="https://d1bxh8uas1mnw7.cloudfront.net/assets/embed.js"></script>
  {% endif %}
  {% if site.enable_publication_badges.dimensions %}
    <script async src="https://badge.dimensions.ai/badge.js"></script>
  {% endif %}
{% endif %}
