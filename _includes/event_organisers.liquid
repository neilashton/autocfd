<section class="event-organisers" aria-labelledby="event-organisers-heading">
  <h2 id="event-organisers-heading">AutoCFD5 Event Organisers</h2>
  <dl class="event-organisers__grid">
    <div class="event-organisers__partner">
      <dt>
        <a class="event-organisers__logo" href="https://www.upstream-cfd.com/" target="_blank" rel="noopener noreferrer">
          <img
            src="{{ '/assets/img/upstreamcfdlogo.png' | relative_url }}"
            alt="Upstream CFD"
            width="204"
            height="153"
            loading="lazy"
            decoding="async"
          >
        </a>
      </dt>
      <dd>Main event organiser</dd>
    </div>
    <div class="event-organisers__partner">
      <dt>
        <a class="event-organisers__logo" href="https://www.cineca.it/en" target="_blank" rel="noopener noreferrer">
          <img src="{{ '/assets/img/cineca-logo.png' | relative_url }}" alt="CINECA" width="3454" height="942" loading="lazy" decoding="async">
        </a>
      </dt>
      <dd>Local organiser, providing venue &amp; organisational support</dd>
    </div>
    <div class="event-organisers__partner">
      <dt>
        <a class="event-organisers__logo" href="https://evcm.it/" target="_blank" rel="noopener noreferrer">
          <img src="{{ '/assets/img/evcmlogo.png' | relative_url }}" alt="EVCM" width="423" height="82" loading="lazy" decoding="async">
        </a>
      </dt>
      <dd>Financial administrator</dd>
    </div>
  </dl>
  <div class="event-organisers__collaboration">
    <h3>In collaboration with</h3>
    <a class="event-organisers__logo event-organisers__logo--collaborator" href="https://euroccitaly.it/" target="_blank" rel="noopener noreferrer">
      <img
        src="{{ '/assets/img/eurocc-italy-logo.png' | relative_url }}"
        alt="EuroCC Italy"
        width="1443"
        height="787"
        loading="lazy"
        decoding="async"
      >
    </a>
  </div>
</section>
