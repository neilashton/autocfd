{% assign seo_organization_id = seo_site_url | append: '#organization' %}
{% assign seo_website_id = seo_site_url | append: '#website' %}
{% assign seo_webpage_id = seo_canonical_url | append: '#webpage' %}
{% assign seo_breadcrumb_id = seo_canonical_url | append: '#breadcrumb' %}
{% assign seo_event_id = seo_site_url | append: '#event' %}
{% assign seo_dataset_id = seo_canonical_url | append: '#dataset' %}

{% assign seo_has_breadcrumb = false %}
{% unless seo_page_path == '/' %}
  {% unless seo_robots contains 'noindex' %}
    {% assign seo_has_breadcrumb = true %}
  {% endunless %}
{% endunless %}

{% assign seo_is_home_event = false %}
{% if seo_page_path == '/' and site.data.seo.event.name %}
  {% assign seo_is_home_event = true %}
{% endif %}

{% assign seo_is_case_dataset = false %}
{% if seo_page_path == '/case1/' or seo_page_path == '/case2/' or page.schema_type == 'Dataset' %}
  {% assign seo_is_case_dataset = true %}
{% endif %}

{% capture seo_dataset_name %}{{ seo_site_name }} {{ seo_page_name }} CFD data and resources{% endcapture %}
{% assign seo_dataset_name = seo_dataset_name | strip %}
{% capture seo_dataset_description -%}
  Downloadable automotive CFD geometry, meshes, reference material, and supporting resources for {{ seo_page_name }}.
{%- endcapture %}
{% assign seo_dataset_description = seo_dataset_description | strip %}

<!-- Structured data -->
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": {{ seo_organization_id | jsonify }},
        "name": {{ seo_organization_name | jsonify }},
        "url": {{ seo_site_url | jsonify }},
        "description": {{ site.description | default: seo_description | strip_html | strip_newlines | strip | jsonify }}
        {% if site.email != blank %},
          "email": {{ site.email | jsonify }}
        {% endif %}
        {% if site.data.seo.organization.same_as %},
          "sameAs": {{ site.data.seo.organization.same_as | jsonify }}
        {% endif %}
      },
      {
        "@type": "WebSite",
        "@id": {{ seo_website_id | jsonify }},
        "url": {{ seo_site_url | jsonify }},
        "name": {{ seo_site_name | jsonify }},
        "alternateName": {{ seo_organization_name | jsonify }},
        "description": {{ site.description | default: seo_description | strip_html | strip_newlines | strip | jsonify }},
        "inLanguage": {{ site.lang | default: 'en' | jsonify }},
        "publisher": {
          "@id": {{ seo_organization_id | jsonify }}
        }
      },
      {
        "@type": "WebPage",
        "@id": {{ seo_webpage_id | jsonify }},
        "url": {{ seo_canonical_url | jsonify }},
        "name": {{ seo_title | jsonify }},
        "description": {{ seo_description | jsonify }},
        "inLanguage": {{ site.lang | default: 'en' | jsonify }},
        "isPartOf": {
          "@id": {{ seo_website_id | jsonify }}
        },
        "about": {
          "@id": {{ seo_organization_id | jsonify }}
        }
        {% if seo_image_url != blank %},
          "primaryImageOfPage": {
            "@type": "ImageObject",
            "url": {{ seo_image_url | jsonify }}
          }
        {% endif %}
        {% if seo_has_breadcrumb %},
          "breadcrumb": {
            "@id": {{ seo_breadcrumb_id | jsonify }}
          }
        {% endif %}
        {% if page.date %},
          "datePublished": {{ page.date | date_to_xmlschema | jsonify }}
        {% endif %}
        {% if page.last_modified_at or page.modified %},
          "dateModified": {{ page.last_modified_at | default: page.modified | date_to_xmlschema | jsonify }}
        {% endif %}
        {% if seo_is_home_event %},
          "mainEntity": {
            "@id": {{ seo_event_id | jsonify }}
          }
        {% elsif seo_is_case_dataset %},
          "mainEntity": {
            "@id": {{ seo_dataset_id | jsonify }}
          }
        {% endif %}
      }
      {% if seo_has_breadcrumb %},
        {
          "@type": "BreadcrumbList",
          "@id": {{ seo_breadcrumb_id | jsonify }},
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": {{ seo_site_url | jsonify }}
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ seo_page_name | jsonify }},
              "item": {{ seo_canonical_url | jsonify }}
            }
          ]
        }
      {% endif %}
      {% if seo_is_home_event %},
        {
          "@type": "Event",
          "@id": {{ seo_event_id | jsonify }},
          "name": {{ site.data.seo.event.name | default: seo_page_name | jsonify }},
          "description": {{ seo_description | jsonify }},
          "url": {{ seo_canonical_url | jsonify }},
          "startDate": {{ site.data.seo.event.start_date | jsonify }},
          "endDate": {{ site.data.seo.event.end_date | jsonify }},
          "eventStatus": "https://schema.org/EventScheduled",
          "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
          "inLanguage": {{ site.lang | default: 'en' | jsonify }},
          "mainEntityOfPage": {
            "@id": {{ seo_webpage_id | jsonify }}
          },
          "organizer": {
            "@id": {{ seo_organization_id | jsonify }}
          },
          "offers": {
            "@type": "Offer",
            "url": {{ site.data.seo.event.registration_url | absolute_url | jsonify }},
            "availability": "https://schema.org/InStock"
          },
          "location": {
            "@type": "Place",
            "name": {{ site.data.seo.event.location.name | jsonify }},
            "address": {
              "@type": "PostalAddress",
              "streetAddress": {{ site.data.seo.event.location.street_address | jsonify }},
              "addressLocality": {{ site.data.seo.event.location.address_locality | jsonify }},
              "addressRegion": {{ site.data.seo.event.location.address_region | jsonify }},
              "postalCode": {{ site.data.seo.event.location.postal_code | jsonify }},
              "addressCountry": {{ site.data.seo.event.location.address_country | jsonify }}
            }
          }
          {% if seo_image_url != blank %},
            "image": {{ seo_image_url | jsonify }}
          {% endif %}
        }
      {% endif %}
      {% if seo_is_case_dataset %},
        {
          "@type": "Dataset",
          "@id": {{ seo_dataset_id | jsonify }},
          "name": {{ seo_dataset_name | jsonify }},
          "description": {{ seo_dataset_description | jsonify }},
          "url": {{ seo_canonical_url | jsonify }},
          "inLanguage": {{ site.lang | default: 'en' | jsonify }},
          "mainEntityOfPage": {
            "@id": {{ seo_webpage_id | jsonify }}
          },
          "creator": {
            "@id": {{ seo_organization_id | jsonify }}
          },
          "publisher": {
            "@id": {{ seo_organization_id | jsonify }}
          },
          "about": [
            {
              "@type": "Thing",
              "name": "Computational fluid dynamics"
            },
            {
              "@type": "Thing",
              "name": "Automotive aerodynamics"
            }
          ]
        }
      {% endif %}
    ]
  }
</script>
