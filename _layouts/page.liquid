---
layout: default
---
<div class="post">
  {% assign page_heading = page.page_title | default: page.title %}
  {% assign page_summary = page.page_description | default: page.description %}
  <header class="post-header">
    {% if page_heading != blank and page_heading != 'blank' %}
      <h1 class="post-title">{{ page_heading }}</h1>
    {% endif %}
    {% if page_summary != blank %}
      <p class="post-description">{{ page_summary }}</p>
    {% endif %}
  </header>

  <article
    {% if page.content_class %}
      class="{{ page.content_class | escape }}"
    {% endif %}
  >
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
